# Supabase (publishable/anon key only; never the service-role key in apps/web)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile (test key: 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Public origin of the web app (OAuth redirect, deep links)
WEB_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Store / extension links (button hidden when unset)
NEXT_PUBLIC_PLAY_URL=
NEXT_PUBLIC_APPSTORE_URL=
NEXT_PUBLIC_CWS_URL=
# App links (filled by phase 12)
ANDROID_PACKAGE_NAME=vn.canhgia.canhgia
ANDROID_SHA256_FINGERPRINTS=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=vn.canhgia.canhgia
